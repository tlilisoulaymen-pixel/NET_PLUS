  {"fieldname": "completion_score", "fieldtype": "Float", "label": "Complétion /20"},
  {"fieldname": "penalties", "fieldtype": "Float", "label": "Pénalités"},
  {"fieldname": "missions_count", "fieldtype": "Int", "label": "Missions (90j)"},
