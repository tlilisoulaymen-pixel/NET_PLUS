{
 "doctype": "DocType",
 "name": "Mission Alert",
 "module": "NetPlus",
 "autoname": "format:ALR-{YYYY}-{#####}",
 "engine": "InnoDB",
 "field_order": ["task", "operator", "level", "status", "delay_minutes",
  "message", "justification", "acknowledged_by", "acknowledged_at"],
 "fields": [
  {"fieldname": "task", "fieldtype": "Link", "label": "Mission", "options": "Task", "reqd": 1, "in_list_view": 1},
  {"fieldname": "operator", "fieldtype": "Link", "label": "Opérateur", "options": "Employee", "reqd": 1, "in_list_view": 1},
  {"fieldname": "level", "fieldtype": "Select", "label": "Niveau", "options": "Avertissement\nAlerte\nCritique", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Statut", "options": "Ouverte\nAcquittée\nEscaladée\nRésolue", "default": "Ouverte", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "delay_minutes", "fieldtype": "Int", "label": "Retard (min)"},
  {"fieldname": "message", "fieldtype": "Small Text", "label": "Message"},
  {"fieldname": "justification", "fieldtype": "Small Text", "label": "Justification (snooze)"},
  {"fieldname": "acknowledged_by", "fieldtype": "Link", "label": "Acquittée par", "options": "User", "read_only": 1},
  {"fieldname": "acknowledged_at", "fieldtype": "Datetime", "label": "Acquittée le", "read_only": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "NetPlus Supervisor", "read": 1, "write": 1}
 ],
 "sort_field": "creation",
 "sort_order": "DESC"
}

