{
 "doctype": "DocType",
 "name": "Service Contract",
 "module": "NetPlus",
 "autoname": "format:CNT-{YYYY}-{#####}",
 "engine": "InnoDB",
 "field_order": ["status", "customer", "supervisor", "site", "parties_section",
  "effective_date", "expiration_date", "service_section", "service_type",
  "frequency", "days_of_week", "scheduled_start_time", "estimated_duration_hours",
  "team_mode", "requires_team_lead", "financial_section", "rate_per_intervention",
  "currency", "billing_cycle", "payment_terms_days", "description",
  "qr_section", "qr_payload"],
 "fields": [
  {"fieldname": "status", "fieldtype": "Select", "label": "Statut", "options": "Draft\nActive\nSuspended\nExpired", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "customer", "fieldtype": "Link", "label": "Client", "options": "Customer", "reqd": 1, "in_list_view": 1},
  {"fieldname": "supervisor", "fieldtype": "Link", "label": "Superviseur", "options": "Employee", "reqd": 1},
  {"fieldname": "site", "fieldtype": "Link", "label": "Site", "options": "Location"},
  {"fieldname": "parties_section", "fieldtype": "Section Break", "label": "Durée"},
  {"fieldname": "effective_date", "fieldtype": "Date", "label": "Date d'effet", "reqd": 1, "in_list_view": 1},
  {"fieldname": "expiration_date", "fieldtype": "Date", "label": "Date d'expiration", "reqd": 1},
  {"fieldname": "service_section", "fieldtype": "Section Break", "label": "Prestation"},
  {"fieldname": "service_type", "fieldtype": "Select", "label": "Type de service", "options": "COMMERCIAL_CLEANING\nRESIDENTIAL_CLEANING\nINDUSTRIAL_CLEANING\nOTHER"},
  {"fieldname": "frequency", "fieldtype": "Select", "label": "Fréquence", "options": "DAILY\nWEEKLY\nBIWEEKLY\nMONTHLY\nCUSTOM"},
  {"fieldname": "days_of_week", "fieldtype": "Data", "label": "Jours (ex: Monday,Friday)"},
  {"fieldname": "scheduled_start_time", "fieldtype": "Time", "label": "Heure de début"},
  {"fieldname": "estimated_duration_hours", "fieldtype": "Float", "label": "Durée estimée (h)", "default": "4"},
  {"fieldname": "team_mode", "fieldtype": "Select", "label": "Mode", "options": "Solo\nÉquipe", "default": "Solo"},
  {"fieldname": "requires_team_lead", "fieldtype": "Check", "label": "Lead d'équipe requis"},
  {"fieldname": "financial_section", "fieldtype": "Section Break", "label": "Conditions financières"},
  {"fieldname": "rate_per_intervention", "fieldtype": "Currency", "label": "Tarif par intervention"},
  {"fieldname": "currency", "fieldtype": "Link", "label": "Devise", "options": "Currency", "default": "CAD"},
  {"fieldname": "billing_cycle", "fieldtype": "Select", "label": "Cycle de facturation", "options": "WEEKLY\nMONTHLY\nQUARTERLY", "default": "MONTHLY"},
  {"fieldname": "payment_terms_days", "fieldtype": "Int", "label": "Délai de paiement (jours)", "default": "30"},
  {"fieldname": "description", "fieldtype": "Text Editor", "label": "Description / clauses"},
  {"fieldname": "qr_section", "fieldtype": "Section Break", "label": "Vérification QR"},
  {"fieldname": "qr_payload", "fieldtype": "Small Text", "label": "Payload QR (auto)", "read_only": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1},
  {"role": "NetPlus Supervisor", "read": 1, "write": 1, "create": 1, "print": 1},
  {"role": "NetPlus Client", "read": 1}
 ],
 "track_changes": 1
}

